pipeline {

    agent none

    parameters {    
        choice(name: 'CHOICE_PARA' , choices: ['dev','stage','prod'], description: 'select one dev')
    }

    environment {
        APP_NAME = 'CHARAN'
    }

    stages{
        stage('checkout'){
            agent {label 'slave1'}
            steps{
                checkout scmGit(branches: [[name: '*/main']], extensions: [], userRemoteConfigs: [[url: 'https://github.com/CHARAN-Chiru-17/test-lamda.git']])
            }
        }
        stage('stage 1'){
            agent {label 'slave1'}
            steps{
                sh '''
                    sleep 10
                    ls -lrt
                    echo "this is a inside stage 1"

                '''
            }
        }
        stage('stage 2 - parallel'){
            parallel{
                stage('parallel-1'){
                    agent {label 'slave2'}
                    steps{
                        echo "this parallel-1"
                    }
                }
                stage('parallel-2'){
                    agent {label 'slave2'}
                    steps{
                        echo "this is parallel-2"
                    }
                }
            }
        }

        stage('stage 3'){
            agent {label 'slave2'}
            when {
                environment name: 'APP_NAME', value: 'CHARAN'
            }
            steps{
                echo 'exceuted only when enviorment is correct'
                sh '''
                    pwd
                    ls

                '''
            }
        }
    }


}